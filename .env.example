# Copy to .env for local use (netlify dev reads it). In production, set these
# in Netlify: Site configuration > Environment variables. Never commit .env.

# Optional. Free OpenSky account > Account > API client. Raises the daily limit.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Required for the claim checker. https://console.anthropic.com > API keys.
# Set a monthly spend limit there too, since the live site is public.
ANTHROPIC_API_KEY=
# Optional: which model reads claims (default claude-sonnet-5-5).
CLAIM_MODEL=

# Ship sensor (free): https://aisstream.io > sign in with GitHub > API Keys.
AISSTREAM_API_KEY=

# Before/after satellite images (free): Copernicus Data Space account >
# Sentinel Hub dashboard > User settings > OAuth clients > Create.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Required for the fire layer. Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
